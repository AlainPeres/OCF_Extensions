{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Exécuter le fichier TS courant (tsx)",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--import", "tsx", "--conditions", "@opencharacter/source"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
